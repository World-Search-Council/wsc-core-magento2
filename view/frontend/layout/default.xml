        <referenceContainer name="after.body.start">
            <block class="Wsc\Analytics\Block\Tracker"
                   name="wsc.analytics.tracker"
                   template="Wsc_Analytics::tracker.phtml"/>
        </referenceContainer>
    </body>
</page>
