<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="wsc" translate="label" sortOrder="900">
            <label>World Search Council</label>
        </tab>
        <section id="wsc_analytics" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>WSC Search &amp; Health Analytics</label>
            <tab>wsc</tab>
            <resource>Wsc_Analytics::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Tracking Settings</label>
                <field id="tracking_active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable WSC Tracking</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="tracking_mode" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tracking Mode</label>
                    <source_model>Wsc\Analytics\Model\Config\Source\TrackingMode</source_model>
                </field>
                <field id="exclude_admins" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Exclude Admin Users</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="gateway" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>WSC Gateway &amp; Hybrid Encryption (Opt-In)</label>
                <field id="hybrid_enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Hybrid Sync to WSC Cloud Gateway (Opt-In)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Disabled by default for Zero-PII privacy compliance. Enable to pair via /v1/register.</comment>
                </field>
                <field id="gateway_url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Gateway URL</label>
                </field>
                <field id="project_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Project ID</label>
                </field>
                <field id="api_secret" translate="label" type="obscure" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Gateway HMAC API Secret</label>
                </field>
                <field id="local_key" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Local AES-256 Key (64-char Hex)</label>
                </field>
            </group>

            <group id="membership" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>WSC Membership, Credentials &amp; Agency Co-Branding</label>
                <field id="license_key" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>WSC Member / Partner Credential Key</label>
                    <comment>Optional credential from worldsearchcouncil.org/member/licenses. 100% of local features remain unlocked without a key.</comment>
                </field>
                <field id="license_status" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Credential Status</label>
                </field>
                <field id="license_tier" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Membership Tier</label>
                </field>
                <field id="license_holder" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Verified Credential Holder</label>
                </field>
                <field id="co_branding" translate="label" type="textarea" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Agency Co-Branding JSON</label>
                </field>
            </group>

            <group id="ai_indexnow" translate="label" type="text" sortOrder="28" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI Readiness (/llms.txt), Benchmarks &amp; Opt-In IndexNow</label>
                <field id="llms_txt_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Serve Public /llms.txt AI Manifest</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="industry_vertical" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Industry Benchmark Vertical</label>
                    <source_model>Wsc\Analytics\Model\Config\Source\IndustryVertical</source_model>
                </field>
                <field id="indexnow_enabled" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Automatic IndexNow Push on Product Save (Opt-In)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Strictly opt-in (default No). Pings api.indexnow.org when active products are saved.</comment>
                </field>
                <field id="indexnow_key" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>IndexNow Verification Key (32-char Hex)</label>
                </field>
            </group>

            <group id="bot_shield" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI &amp; Search Bot Shield</label>
                <field id="bot_tracking_level" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Bot Tracking Scope</label>
                    <source_model>Wsc\Analytics\Model\Config\Source\BotLevel</source_model>
                </field>
            </group>

            <group id="ecommerce" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>E-Commerce Order Tracking</label>
                <field id="track_server_orders" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>100% Ad-Blocker Immune Server-Side Order Tracking</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="auto_downloads" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Auto-track file downloads</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="auto_time_on_page" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Auto-track engaged time on page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="maintenance" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Data Retention</label>
                <field id="retention_days" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Local Queue Retention (Days)</label>
                </field>
            </group>
        </section>
    </system>
</config>
