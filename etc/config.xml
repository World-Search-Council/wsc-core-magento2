<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <wsc_analytics>
            <general>
                <tracking_active>1</tracking_active>
                <tracking_mode>cookieless</tracking_mode>
                <exclude_admins>1</exclude_admins>
            </general>
            <gateway>
                <hybrid_enabled>0</hybrid_enabled>
                <gateway_url>https://api.worldsearchcouncil.org</gateway_url>
            </gateway>
            <membership>
                <license_status>unregistered</license_status>
                <license_tier>community</license_tier>
                <license_expires>0</license_expires>
                <license_is_demo>0</license_is_demo>
            </membership>
            <ai_indexnow>
                <llms_txt_enabled>1</llms_txt_enabled>
                <industry_vertical>/Shopping/Apparel</industry_vertical>
                <indexnow_enabled>0</indexnow_enabled>
            </ai_indexnow>
            <bot_shield>
                <bot_tracking_level>search_ai</bot_tracking_level>
            </bot_shield>
            <ecommerce>
                <track_server_orders>1</track_server_orders>
                <auto_downloads>0</auto_downloads>
                <auto_time_on_page>0</auto_time_on_page>
            </ecommerce>
            <maintenance>
                <retention_days>30</retention_days>
            </maintenance>
        </wsc_analytics>
    </default>
</config>
